# Copy this file to .env and fill in real values. Never commit .env.
# Port the server listens on (optional, default 3000)
PORT=3000

# Secret used to sign login sessions. Required in production. Use a long random text.
SESSION_SECRET=change-me-to-a-long-random-text

# Owner account, created at first start if it does not exist yet (FR-25)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-owner-password
# Name shown for the owner (optional)
OWNER_NAME=Owner
OWNER_PIN=111111

# Set to yes once to replace the owner's PIN and password with the values above on the next start.
# Remove it again after signing in.
# RESET_OWNER=yes

# Optional: lets customers pay online by card (Stripe Checkout) instead of at pickup.
# Use a Stripe **test** secret key (starts with sk_test_), from your Stripe dashboard.
# Without this, the shop works exactly as before: pay at pickup only.
# STRIPE_SECRET_KEY=sk_test_...
